# ── Acesso (uso pessoal) ─────────────────────────────────────────────
# Sem APP_PASSWORD o app fica aberto (bom para rodar local).
APP_PASSWORD=""
# Segredo para assinar o cookie de sessão (string longa e aleatória).
AUTH_SECRET=""

# ── Strava (https://www.strava.com/settings/api) ─────────────────────
# Authorization Callback Domain = seu domínio (ou localhost).
# Callback usado pelo app: /api/strava/callback
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# ── AI Performance Analyst (opcional) ────────────────────────────────
# Sem a chave, o analista local (determinístico) responde às perguntas-chave.
ANTHROPIC_API_KEY=""
# ANALYST_MODEL="claude-opus-5"

# ── Persistência ─────────────────────────────────────────────────────
# Pasta do store JSON. Padrão: ./.data (local) ou /tmp (Vercel, efêmero).
# DATA_DIR=""
